{
  "name": "rollback-gate",
  "version": "0.0.0",
  "private": true,
  "description": "CI gate: can the last release's code still run on the database head's Prisma migrations leave?",
  "type": "module",
  "bin": {
    "rollback-gate": "dist/cli.js"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "lint": "biome check . && tsc --noEmit",
    "test": "vitest run --dir src",
    "test:e2e": "npm run build && vitest run --dir e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@prisma/get-dmmf": "7.10.1",
    "libpg-query": "18.2.2"
  }
}
