    {
      "ruleId": "RG-DB-002",
      "severity": "UNSAFE",
      "target": "User.name",
      "file": "prisma/migrations/20261110000000_cleanup/migration.sql",
      "line": 2,
      "action": 0,
      "reason": "Base uses column \"User\".\"name\": by default base's Prisma client selects every scalar column of a model, so every query on the model fails, not only the ones that use this field.",
      "fix": "Retire the field first (@ignore it and stop writing it; make it nullable if it is required), then drop it one release later."
    },
    {
      "ruleId": "RG-DB-019",
      "severity": "RISKY",
      "target": "Post",
      "file": "prisma/migrations/20261110000000_cleanup/migration.sql",
      "line": 3,
      "action": 0,
      "reason": "The DELETE removes rows from \"Post\", which base reads: base code that expects the deleted rows (lookups, seeds, references) fails or misbehaves.",
      "fix": "Soft-delete, or delete in a later release once base no longer reads those rows."
    },
    {
      "ruleId": "RG-DB-001",
      "severity": "SAFE",
      "target": "odd`|<b>*_name",
      "file": "prisma/migrations/20261110000000_cleanup/migration.sql",
      "line": 4,
      "action": 0,
      "reason": "Base doesn't use table \"odd`|<b>*_name\" (no model maps to it, or it's @@ignore), so dropping it can't break base."
    },
