datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

model User {
  id       Int     @id @default(autoincrement())
  slug     String  @default(dbgenerated("gen_random_uuid()::text"))
  seq      Int     @default(autoincrement())
}
